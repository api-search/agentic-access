---
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/security/</loc>
    <priority>1.0</priority>
  </url>
  {% for item in site.scopes %}{% unless item.sitemap == false or item.layout == 'redirect' %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    {% if item.modified %}<lastmod>{{ item.modified | date_to_xmlschema }}</lastmod>{% endif %}
    <priority>0.7</priority>
  </url>
  {% endunless %}{% endfor %}
</urlset>
